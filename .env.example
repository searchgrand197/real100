# Copy to .env and fill in. Never commit .env.
# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,api.real100agro.com
FRONTEND_ORIGIN=https://real100agro.uic-21mca2105.workers.dev,http://localhost:8001,http://127.0.0.1:8001,http://localhost:8000,http://127.0.0.1:8000
# --- Database (Postgres in production; SQLite when unset, dev only) ---
DATABASE_URL=postgres://real100agro:PASSWORD@HOST:5432/real100agro
# --- Firebase Phone Auth (OTP) ---
# Same project the clinic site uses. The storefront sends the SMS;
# this server only checks the ID token. No service-account file needed.
FIREBASE_PROJECT_ID=kushnath-19401
# Dev only: ALLOW_DEMO_AUTH=1 accepts demo:+91xxxxxxxxxx without Firebase.
# Leave at 0 so login is the real SMS code.
ALLOW_DEMO_AUTH=0
DEMO_OTP=1234
# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# --- Delhivery ---
DELHIVERY_API_TOKEN=
DELHIVERY_BASE_URL=https://track.delhivery.com
DELHIVERY_PICKUP_NAME=real100agro warehouse
# --- Email (order mails) ---
# GoDaddy SMTP, same mailbox the clinic site sends from.
# The From address must be that mailbox. Reply-To is the shop inbox.
EMAIL_HOST=smtpout.secureserver.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=support@intvice.com
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=real100agro <support@intvice.com>
ORDER_NOTIFY_EMAIL=support@real100agroindia.com
# Temporary dev BCC of every outgoing mail. Leave empty before hosting.
EMAIL_COPY_TO=
STORE_SUPPORT_EMAIL=support@real100agroindia.com
STORE_SUPPORT_PHONE=+91 94131 75726
# --- Store ---
STORE_GSTIN=06AAKCR6284N1ZM
STORE_FSSAI=10821008000026
